generator client {
    provider = "prisma-client-js"
    binaryTargets = ["native", "rhel-openssl-3.0.x"]
}

datasource db {
    provider = "postgresql"
    url      = env("DATABASE_URL")
}

model Photo {
    id          String   @id @default(uuid())
    title       String
    category    String // Ex: Musique, Mariage, etc.
    location    String? // Ex: Stade de Dillon, Fort-de-France
    description String?
    imageUrl    String
    publicId    String
    createdAt   DateTime @default(now())
}
